# Process AI demo server settings. Copied to deploy/.env by install.sh and fill in.

# Web address, e.g. processai.example.com (DNS A record → this server), or <ip-with-dashes>.sslip.io
DOMAIN=
# Database password (install.sh generates one)
POSTGRES_PASSWORD=
# Everyone needs this code once to open the demo (install.sh generates one)
DEMO_ACCESS_CODE=

# Sign-in: development users for the demo (Microsoft Entra ID later: see docs/notes/entra-setup.md)
AUTH_MODE=dev
ALLOW_DEV_AUTH=true
# Demo processes (Vendor Onboarding etc.); set to false for real data only
SEED_DEMO_ON_START=true

# AI (paste your own key here on the server; never commit it)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-5.4-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
# Monthly token cap for the whole demo (0 = none). 5,000,000 ≈ a few hundred interview turns.
AI_MONTHLY_TOKEN_BUDGET=5000000
# USD per million tokens, for the AI usage page (optional)
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
LLM_PRICE_EMBEDDING_PER_MTOK=0

ORG_CODE=7X
TRANSCRIPT_RETENTION_MONTHS=24
