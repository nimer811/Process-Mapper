# ---- Runtime ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Database (docker compose exposes Postgres on 5433 to avoid clashing with a local server) ----
DATABASE_URL=postgres://process_ai:process_ai@localhost:5433/process_ai

# ---- Auth ----
# dev   = pick a seeded user on the login page (never allowed when NODE_ENV=production)
# entra = Microsoft Entra ID (Phase 6)
AUTH_MODE=dev

# ---- LLM (Phase 2+). Temporary personal key now; Azure OpenAI later. ----
# LLM_PROVIDER=openai | azure
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-5.4-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
# Optional: separate (e.g. stronger) model for structured extraction
LLM_EXTRACTION_MODEL=
# Only for LLM_PROVIDER=azure
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_API_VERSION=

# ---- File storage (Phase 3) ----
STORAGE_DIR=./storage

# ---- AI usage (cost view and budget) ----
# Tokens per calendar month across all AI features; 0 = no limit (warns at 80%, pauses at 100%).
AI_MONTHLY_TOKEN_BUDGET=0
# USD per million tokens, for the AI usage page (0 = cost not shown).
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
LLM_PRICE_EMBEDDING_PER_MTOK=0

# ---- Data retention ----
# Interview transcripts are removed this many months after an interview ends (0 = keep).
TRANSCRIPT_RETENTION_MONTHS=24

# ---- Sign-in with Microsoft Entra ID (see docs/notes/entra-setup.md) ----
# AUTH_MODE=entra
# ALLOW_DEV_AUTH=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Defaults to api://<ENTRA_CLIENT_ID>/access_as_user
ENTRA_API_SCOPE=
# Object id of the Entra group whose members are Process AI admins (or use the "Admin" app role)
ENTRA_ADMIN_GROUP_ID=
ENTRA_ADMIN_ROLE=Admin

# ---- Document IDs ----
ORG_CODE=7X
