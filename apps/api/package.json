{
  "name": "@process-ai/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev:mock-ai": "tsx --env-file-if-exists=../../.env scripts/dev-mock-ai.ts",
    "eval:interview": "tsx --env-file-if-exists=../../.env scripts/eval/run-eval.ts"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.90",
    "@ai-sdk/openai": "^4.0.83",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/sensible": "^6.0.6",
    "@fastify/static": "^10.1.5",
    "@process-ai/agent": "workspace:*",
    "@process-ai/db": "workspace:*",
    "@process-ai/diagram": "workspace:*",
    "@process-ai/knowledge": "workspace:*",
    "@process-ai/shared": "workspace:*",
    "ai": "^7.0.127",
    "elkjs": "^0.12.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "^0.8.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22",
    "@types/pdfkit": "^0.17.6",
    "docx": "^9.8.1",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
