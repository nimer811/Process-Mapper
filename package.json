{
  "name": "process-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @process-ai/api --filter @process-ai/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:generate": "pnpm --filter @process-ai/db generate",
    "db:migrate": "pnpm --filter @process-ai/db migrate",
    "db:seed": "pnpm --filter @process-ai/db seed",
    "docker:build": "docker build -t process-ai:local .",
    "docker:up": "docker compose --profile app up -d --build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
